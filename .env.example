# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# WebSocket URL for Chat Widget
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Backend Database
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Encryption Key for OAuth tokens (Must be 32 characters long)
MASTER_DECRYPTION_KEY=0123456789abcdef0123456789abcdef

# Twitch App Credentials (from https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=your_twitch_client_id
